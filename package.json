{
  "name": "godent-cms",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*"
  ],
  "trustedDependencies": [
    "bun"
  ],
  "scripts": {
    "typecheck": "bun run --cwd apps/admin typecheck && bun run --cwd apps/website typecheck && bun run --cwd apps/api typecheck && bun --bun tsc --noEmit --project tsconfig.json",
    "lint": "bun --bun eslint apps/admin apps/website apps/api/src apps/api/test scripts/*.ts --max-warnings 0",
    "build": "bun run --cwd apps/admin build && bun run --cwd apps/website build && bun run --cwd apps/api build",
    "test": "bun test apps/api/test",
    "setup:local": "bun scripts/local-setup.ts",
    "infra:up": "docker compose up -d --wait --wait-timeout 90",
    "check:services": "bun scripts/check-services.ts",
    "check:api": "bun scripts/check-api.ts",
    "start:admin": "bun scripts/start-service.ts admin",
    "start:website": "bun scripts/start-service.ts website",
    "start:api": "bun scripts/start-service.ts api",
    "start:local": "bun scripts/start-local.ts",
    "s02:bootstrap": "bun scripts/s02-bootstrap.ts --local-s02",
    "s02:migrate": "bun --env-file=.local/s02.env scripts/s02-migrate.ts --local-s02",
    "s02:fixtures": "bun --env-file=.env --env-file=.local/s02.env scripts/s02-fixtures.ts --local-s02 --synthetic-fixtures",
    "test:s02": "bun scripts/check-s02.ts",
    "s03:migrate": "bun --env-file=.local/s02.env scripts/s02-migrate.ts --local-s02",
    "s03:fixtures": "bun --env-file=.local/s02.env scripts/s03-fixtures.ts --local-s03 --synthetic-fixtures",
    "test:s03": "bun scripts/check-s03.ts",
    "s04:bootstrap": "bun --env-file=.env scripts/s04-bootstrap.ts --local-s04",
    "s04:migrate": "bun --env-file=.local/s02.env --env-file=.local/s04.env scripts/s04-migrate.ts --local-s04",
    "s04:fixtures": "bun --env-file=.env --env-file=.local/s02.env --env-file=.local/s04.env scripts/s04-fixtures.ts --local-s04 --synthetic-fixtures",
    "test:s04": "bun scripts/check-s04.ts",
    "s05:bootstrap": "bun --env-file=.env scripts/s05-bootstrap.ts --local-s05",
    "s05:migrate": "bun --env-file=.local/s02.env scripts/s05-migrate.ts --local-s05",
    "s05:migrate:worker": "bun --env-file=.local/s02.env scripts/s05-migrate.ts --local-s05 --include-worker",
    "s05:fixtures": "bun --env-file=.env --env-file=.local/s02.env --env-file=.local/s04.env --env-file=.local/s05.env scripts/s05-fixtures.ts --local-s05 --synthetic-fixtures",
    "start:s05-worker": "bun scripts/start-s05-worker.ts",
    "test:s05": "bun scripts/check-s05.ts",
    "check:api:s05": "bun scripts/check-api.ts --s05",
    "m2:bootstrap": "bun --env-file=.env scripts/m2-bootstrap.ts --local-m2",
    "m2:migrate": "bun --env-file=.local/s02.env scripts/m2-migrate.ts --local-m2",
    "m2:storage": "bun --env-file=.env --env-file=.local/m2.env scripts/m2-storage-bootstrap.ts --local-m2",
    "m2:fixtures": "bun --env-file=.env --env-file=.local/s02.env --env-file=.local/s04.env --env-file=.local/m2.env scripts/m2-ui-fixtures.ts --local-m2 --synthetic-fixtures",
    "start:m2-worker": "bun --env-file=.env scripts/start-m2-worker.ts",
    "test:s06": "bun scripts/check-m2.ts s06",
    "test:s07": "bun scripts/check-m2.ts s07",
    "test:s08": "bun scripts/check-m2.ts s08",
    "m3:bootstrap": "bun --env-file=.env scripts/m3-bootstrap.ts --local-m3",
    "m3:migrate": "bun --env-file=.local/s02.env scripts/m3-migrate.ts --local-m3 --through=0031",
    "m3:fixtures": "bun --env-file=.env --env-file=.local/s02.env --env-file=.local/s04.env --env-file=.local/m2.env scripts/m3-fixtures.ts --local-m3 --synthetic-fixtures",
    "m3:demo": "bun --env-file=.env --env-file=.local/s02.env --env-file=.local/s04.env --env-file=.local/m2.env scripts/m3-demo-fixtures.ts --local-m3 --synthetic-fixtures",
    "m3:performance": "bun --env-file=.env --env-file=.local/s02.env --env-file=.local/s04.env --env-file=.local/m2.env scripts/m3-performance.ts --local-m3 --synthetic-fixtures",
    "m3:worker-scope": "bun --env-file=.local/s02.env scripts/m3-fixtures.ts --local-m3 --synthetic-fixtures --enroll-content-worker",
    "m3:readonly": "bun --env-file=.env scripts/m3-readonly-checks.ts --local-m3",
    "m3:preserve": "bun --env-file=.env scripts/m3-preservation.ts --local-m3 compare",
    "start:m3-worker": "bun scripts/start-m3-worker.ts",
    "test:m3:unit": "bun scripts/check-m3.ts unit",
    "test:m3": "bun scripts/check-m3.ts integration",
    "m4:bootstrap": "bun --env-file=.env scripts/m4-bootstrap.ts --local-m4",
    "m4:migrate": "bun --env-file=.local/s02.env scripts/m4-migrate.ts --local-m4",
    "m4:fixtures": "bun --env-file=.env --env-file=.local/s02.env --env-file=.local/s04.env --env-file=.local/m2.env scripts/m4-fixtures.ts --local-m4 --synthetic-fixtures",
    "m4:demo": "bun --env-file=.env --env-file=.local/s02.env --env-file=.local/s04.env --env-file=.local/m2.env scripts/m4-demo-fixtures.ts --local-m4 --synthetic-fixtures",
    "m4:worker-scope": "bun --env-file=.local/s02.env scripts/m4-fixtures.ts --local-m4 --synthetic-fixtures --enroll-content-worker",
    "m4:preserve": "bun --env-file=.env scripts/m4-preservation.ts --local-m4 compare",
    "start:m4-worker": "bun scripts/start-m4-worker.ts",
    "check:runtime:m4": "bun scripts/m4-runtime-checks.ts --local-m4",
    "check:ui:m4": "bun scripts/m4-full-browser.ts --local-m4",
    "test:m4:unit": "bun scripts/check-m4.ts unit",
    "test:m4": "bun scripts/check-m4.ts integration",
    "m5:bootstrap": "bun --env-file=.env scripts/m5-bootstrap.ts --local-m5",
    "m5:migrate": "bun --env-file=.local/s02.env scripts/m5-migrate.ts --local-m5 --through=0058",
    "m5:fixtures": "bun --env-file=.env --env-file=.local/s02.env scripts/m5-fixtures.ts --local-m5 --synthetic-fixtures",
    "m5:demo": "bun --env-file=.env --env-file=.local/s02.env scripts/m5-demo.ts --local-m5 --synthetic-fixtures",
    "m5:preserve": "bun --env-file=.env scripts/m5-preservation.ts --local-m5 compare",
    "check:runtime:m5": "bun --env-file=.env scripts/m5-runtime-checks.ts --local-m5",
    "m5:domain-proof": "bun --env-file=.local/s02.env scripts/m5-domain-attestation.ts --local-m5 --enroll-local-domain-proof",
    "check:secrets:m5": "bun --no-env-file scripts/m5-secret-check.ts --local-m5",
    "test:m5:unit": "bun --no-env-file test apps/api/test/m5-domains.test.ts apps/api/test/m5-domains-safety.test.ts apps/api/test/m5-platform-unit.test.ts apps/api/test/m5-platform-export.test.ts apps/api/test/m5-platform-worker.test.ts apps/api/test/m5-root.test.ts apps/api/test/domain-input.test.ts",
    "audit-expiry:migrate": "bun --env-file=.local/s02.env scripts/audit-expiry-migrate.ts --local-audit-expiry",
    "audit-expiry:fixtures": "bun --env-file=.env --env-file=.local/s02.env scripts/audit-expiry-fixtures.ts --local-audit-expiry --synthetic-fixtures",
    "start:audit-expiry-worker": "bun --no-env-file scripts/start-audit-expiry-worker.ts",
    "audit-expiry:preserve": "bun --env-file=.env scripts/audit-expiry-preservation.ts --local-audit-expiry compare"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.3.1",
    "@types/node": "22.18.6",
    "bun": "1.4.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
